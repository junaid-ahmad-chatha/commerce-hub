PORT=3100
LOCAL_APP_ORIGIN=http://localhost:3100
# HTTPS tunnel origin, no path. Required for eBay/Amazon browser OAuth.
OAUTH_CALLBACK_ORIGIN=
# Optional 32 random bytes encoded in base64. Otherwise data/connection-key is generated.
COMMERCE_TOKEN_KEY=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory
SHOPIFY_API_VERSION=2026-10

EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay Redirect URL NAME (RuName), not a literal URL.
EBAY_RUNAME=
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.account.readonly

# SP-API LWA credentials, not AWS access keys.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Browser OAuth only; private-app self-authorization does not require this.
AMAZON_APPLICATION_ID=
AMAZON_REGION=na
AMAZON_MARKETPLACE=US
AMAZON_DRAFT=true

