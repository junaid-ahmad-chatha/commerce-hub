{
  "name": "commerce-hub",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local-first multichannel inventory and order workbench",
  "engines": { "node": "24.x" },
  "dependencies": { "pg": "8.23.1" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:postgres": "node scripts/verify-security-postgres.mjs",
    "test:shopify-oauth": "node scripts/verify-shopify-oauth.mjs",
    "package:heroku": "node scripts/package-heroku.mjs"
  }
}

